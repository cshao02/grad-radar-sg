{
  "name": "grad-radar-sg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fresh-grad software and agent engineering job radar for Singapore, with match scores and an application tracker.",
  "scripts": {
    "dev:ui": "node vite.mjs --dev",
    "dev:server": "node server/index.mjs",
    "build": "tsc --noEmit && node vite.mjs",
    "build:static": "tsc --noEmit && node vite.mjs --static",
    "start": "node server/index.mjs",
    "refresh": "node server/refresh-cli.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
